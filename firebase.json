{
  "firestore": {
    "database": "krishix3090",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "apphosting": [
    {
      "backendId": "apphosting",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ],
      "alwaysDeployFromSource": true
    }
  ],
  "hosting": {
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "apphosting",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-eval'; connect-src 'self' https://*.firebaseio.com https://securetoken.googleapis.com https://*.googleapis.com; frame-src 'self' https://*.firebaseapp.com https://*.firebaseauth.com https://accounts.google.com;"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "bucket": "fieldverse-m99ip.firebasestorage.app"
  },
  "database": {
    "rules": "database.rules.json"
  }
}
