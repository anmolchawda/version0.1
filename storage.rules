
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Allow public read access to all files by default.
    // This is simple for development but you might want to restrict it later.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow authenticated users to write files to user-specific folders.
    // This covers avatars, post images/videos, and mandi listing images.
    match /{folder}/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId
                   && (folder == 'avatars' || folder == 'posts' || folder == 'mandi_listings');
    }
  }
}
