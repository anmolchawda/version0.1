rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow avatar uploads for logged-in users to their own folder
    match /avatars/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow post image uploads for logged-in users to their own folder
    match /posts/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow Mandi listing image uploads for logged-in users to their own folder
    match /mandi_listings/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
