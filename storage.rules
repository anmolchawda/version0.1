rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read and write access for all authenticated users.
    // This is permissive and suitable for development.
    // For production, restrict write access to specific paths per user.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
