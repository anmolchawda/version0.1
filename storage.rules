rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatars: Users can only write their own avatar. Anyone can read.
    match /avatars/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Posts: Users can only write to their own post media folder. Anyone can read.
    match /posts/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Mandi Listings: Users can only write to their own mandi listings folder. Anyone can read.
    match /mandi_listings/{userId}/{fileName} {
        allow read;
        allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
