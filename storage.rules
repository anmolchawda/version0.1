
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to shared asset folders.
    match /Crop images/{allPaths=**} {
      allow read: if true;
    }
    match /Tomato Diseases/{allPaths=**} {
      allow read: if true;
    }
     match /KrishiX logo/{allPaths=**} {
      allow read: if true;
    }

    // Users can only write to their own folder in storage.
    // This covers profile pictures and post images/videos.
    match /{path}/{userId}/{allPaths=**} {
      allow read: if true; // Allow public read of user-uploaded content
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
