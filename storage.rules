
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default to allowing public read access for simplicity.
    // Writes are restricted to logged-in users.
    match /{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // More specific rules for user-specific uploads.
    // Users can only write to their own folder.
    match /posts/{userId}/{fileName} {
        allow write: if request.auth.uid == userId;
    }
    
    match /avatars/{userId}/{fileName} {
        allow write: if request.auth.uid == userId;
    }

    match /mandi_listings/{userId}/{fileName} {
        allow write: if request.auth.uid == userId;
    }
  }
}
