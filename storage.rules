
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read on user avatars and post images
    match /avatars/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /posts/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /mandi_listings/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Publicly readable images from Crop Science feature and other static assets
    match /Crop images/{allPaths=**} {
      allow read;
      allow write: if false;
    }
    match /Tomato Diseases/{allPaths=**} {
      allow read;
      allow write: if false;
    }
    match /KrishiX logo/{allPaths=**} {
      allow read;
      allow write: if false;
    }

  }
}
