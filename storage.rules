rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files by default.
    // This is useful for images which need to be displayed to all users.
    match /{allPaths=**} {
      allow read;
    }
    
    // Secure user uploads. Only the authenticated user can write to their own path.
    // The path should include the user's UID to enforce this.
    // e.g., 'posts/USER_ID/filename.jpg'
    match /posts/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Secure mandi listing uploads
    match /mandi_listings/{userId}/{allPaths=**} {
        allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
