{
  "rules": {
    "databases": [
      {
        "database": "(default)",
        "rules": {
          "match": "/{document=**}" : {
            "allow read, write": false
          },

          "match": "/users/{userId}" : {
            "allow read": true,
            "allow create": "if request.auth != null && request.auth.uid == userId",
            "allow update": "if request.auth != null && request.auth.uid == userId",

            "match": "/bookmarks/{postId}": {
              "allow read, write": "if request.auth != null && request.auth.uid == userId"
            },
            
            "match": "/followers/{followerId}": {
              "allow read": true,
              "allow write": "if request.auth != null && request.auth.uid == followerId"
            },

            "match": "/following/{followedId}": {
              "allow read": true,
              "allow write": "if request.auth != null && request.auth.uid == userId"
            }
          },
          
          "match": "/posts/{postId}": {
            "allow read": true,
            "allow create, update, delete": "if request.auth != null && request.auth.uid == request.resource.data.userId"
          },

          "match": "/posts/{postId}/comments/{commentId}": {
            "allow read": true,
            "allow create": "if request.auth != null && request.auth.uid == request.resource.data.user.id",
            "allow update, delete": "if request.auth != null && request.auth.uid == resource.data.user.id"
          },

          "match": "/posts/{postId}/likedByUsers/{userId}": {
             "allow read": true,
             "allow write": "if request.auth != null && request.auth.uid == userId"
          },
          
          "match": "/conversations/{conversationId}": {
            "allow read, write": "if request.auth != null && request.auth.uid in resource.data.participants"
          },
          
          "match": "/conversations/{conversationId}/messages/{messageId}": {
            "allow read, write": "if request.auth != null && request.auth.uid in get(/databases/(default)/documents/conversations/$(conversationId)).data.participants"
          },
          
          "match": "/notificationsMeta/{userId}": {
            "allow read, write": "if request.auth != null && request.auth.uid == userId"
          },

          "match": "/notifications/{userId}/items/{notificationId}": {
            "allow read, write, delete": "if request.auth != null && request.auth.uid == userId"
          },

          "match": "/mandi_listings/{listingId}": {
            "allow read": true,
            "allow create": "if request.auth != null",
            "allow update, delete": "if request.auth != null && request.auth.uid == resource.data.sellerId"
          },
          
          "match": "/mandi_buyer_requests/{requestId}": {
            "allow read": true,
            "allow create": "if request.auth != null",
            "allow update, delete": "if request.auth != null && request.auth.uid == resource.data.postedById"
          },

          "match": "/yojna/{yojnaId}": {
             "allow read": true,
             "allow write": false
          }
        }
      }
    ]
  }
}
