
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to posts and user profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Allow update/delete only by the post owner
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /posts/{postId}/comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && resource.data.user.id == request.auth.uid;
    }

    // Allow logged-in users to manage their own bookmarks and likes
    match /users/{userId}/bookmarks/{postId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
     match /posts/{postId}/likedByUsers/{userId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Allow logged-in users to manage their notifications
    match /notificationsMeta/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /notifications/{userId}/items/{notificationId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Allow logged-in users to interact with Mandi
     match /mandi_listings/{listingId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

     match /mandi_buyer_requests/{requestId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && resource.data.postedById == request.auth.uid;
    }

    // Allow read-only access to public data like Yojnas
    match /yojna/{yojnaId} {
      allow read: if true;
      allow write: if false; // Only from console
    }

    // Secure conversations between participants
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if false; // Messages are immutable
      }
    }
  }
}
