
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: Can read any profile, but can only write to their own.
    match /users/{userId} {
      allow read: if true; // Publicly readable profiles
      allow write: if request.auth.uid == userId;

      // Subcollections for user-specific data
      match /bookmarks/{postId} {
        allow read, write, delete: if request.auth.uid == userId;
      }
      match /followers/{followerId} {
        allow read: if true;
        allow write, delete: if request.auth.uid == userId || request.auth.uid == followerId;
      }
      match /following/{followingId} {
        allow read: if true;
        allow write, delete: if request.auth.uid == userId;
      }
    }

    // Posts: Make posts readable by anyone to fix the permission issue.
    // Create/Update/Delete actions are still protected.
    match /posts/{postId} {
      allow read: if true; // Allow public read access to all posts
      allow create, update, delete: if request.auth.uid == resource.data.userId;

      // Subcollections for post-specific data
      match /comments/{commentId} {
        allow read: if true; // Allow public read access to comments
        allow create: if request.auth.uid != null;
      }
      match /likedByUsers/{userId} {
        allow read, create, delete: if request.auth.uid == userId;
      }
    }

    // Conversations & Messages
    match /conversations/{conversationId} {
      // Allow read/write only if the user is a participant
      allow read, write: if request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
    
    // Notifications: Can only be read and written by the target user.
    match /notifications/{userId}/{notificationType}/{notificationId} {
      allow read, write, delete: if request.auth.uid == userId;
    }
  }
}
