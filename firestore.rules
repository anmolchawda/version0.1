
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read on user profiles, but only the user can write to their own profile.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read on posts. Only authenticated users can create posts.
    // Only the author can update or delete their own post.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Allow public read on comments. Only authenticated users can create comments.
    // Only the author can delete their own comment.
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.user.id == request.auth.uid;
    }

    // Users can only manage their own subcollections (bookmarks, likes, follows).
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow public read on posts' like lists.
    match /posts/{postId}/likedByUsers/{userId} {
        allow read: if true;
        allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read on Mandi listings. Authenticated users can create them.
    // Only the seller can update/delete their own listing.
    match /mandi_listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // Allow public read on buyer requests. Authenticated users can create them.
    // Only the author can delete their own request.
    match /mandi_buyer_requests/{requestId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.postedById == request.auth.uid;
    }

    // Conversations can only be accessed by participants.
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
    }
    
    // Messages within a conversation can only be accessed by participants.
    match /conversations/{conversationId}/messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Notifications data and metadata can only be accessed by the owner.
    match /notificationsMeta/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /notifications/{userId}/items/{notificationId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Public data like Yojna can be read by anyone.
    match /yojna/{yojnaId} {
      allow read: if true;
      allow write: if false; // Assume it's managed from the Firebase console
    }
  }
}
