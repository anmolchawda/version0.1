{
  "rules": {
    "users": {
      "$uid": {
        ".read": "request.auth != null",
        ".write": "request.auth.uid == $uid",
        "bookmarks": {
          "$postId": {
            ".read": "request.auth.uid == $uid",
            ".write": "request.auth.uid == $uid"
          }
        },
        "followers": {
          "$followerId": {
            ".read": "request.auth.uid == $uid",
            ".write": "request.auth.uid == $followerId"
          }
        },
        "following": {
          "$followedId": {
            ".read": "request.auth != null",
            ".write": "request.auth.uid == $uid"
          }
        }
      }
    },
    "posts": {
      "$postId": {
        ".read": "request.auth != null",
        ".update": "resource.data.userId == request.auth.uid",
        ".delete": "resource.data.userId == request.auth.uid",
        ".create": "request.auth != null && request.resource.data.userId == request.auth.uid",
        "comments": {
          "$commentId": {
            ".read": "request.auth != null",
            ".create": "request.auth != null && request.resource.data.user.id == request.auth.uid"
          }
        },
        "likedByUsers": {
          "$uid": {
            ".read": "request.auth != null",
            ".write": "request.auth.uid == $uid"
          }
        }
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "request.auth.uid in resource.data.participants",
        ".write": "request.auth.uid in resource.data.participants",
        "messages": {
          "$messageId": {
            ".read": "request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants",
            ".create": "request.auth.uid == request.resource.data.senderId && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants"
          }
        }
      }
    },
    "notifications": {
      "$userId": {
        "items": {
          "$notificationId": {
            ".read, .write, .delete": "request.auth.uid == $userId"
          }
        }
      }
    },
    "notificationsMeta": {
      "$userId": {
        ".read, .write": "request.auth.uid == $userId"
      }
    },
    "mandi_listings": {
      "$listingId": {
        ".read": "request.auth != null",
        ".create": "request.auth != null && request.resource.data.sellerId == request.auth.uid",
        ".update": "resource.data.sellerId == request.auth.uid",
        ".delete": "resource.data.sellerId == request.auth.uid"
      }
    },
    "mandi_buyer_requests": {
      "$requestId": {
        ".read": "request.auth != null",
        ".create": "request.auth != null && request.resource.data.postedById == request.auth.uid",
        ".delete": "resource.data.postedById == request.auth.uid"
      }
    },
    "yojna": {
      "$yojnaId": {
        ".read": "request.auth != null",
        ".write": false
      }
    }
  }
}
