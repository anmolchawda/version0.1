{
  "rules": {
    "users": {
      "{userId}": {
        // A user can create their own document, and update/delete it.
        "allow create, update, delete": "request.auth.uid == userId",
        // Any authenticated user can read any single profile.
        "allow get": "request.auth != null",

        // Rules for user-specific subcollections
        "bookmarks": {
          // A user can only manage their own bookmarks.
          // path: /users/{userId}/bookmarks/{postId}
          "allow read, write, delete": "request.auth.uid == userId"
        },
        "followers": {
          // Anyone can read who follows a user.
          "allow read": "request.auth != null",
          // Only the follower can add/remove themselves from a user's followers list.
          // path: /users/{userId}/followers/{followerId}
          "{followerId}": {
            "allow write, delete": "request.auth.uid == followerId"
          }
        },
        "following": {
          // A user can only manage their own 'following' list.
          // path: /users/{userId}/following/{followedUserId}
          "allow read, write, delete": "request.auth.uid == userId"
        }
      }
    },
    "posts": {
      // Anyone can read posts.
      "allow read": true,
      // Logged-in users can create posts.
      "allow create": "request.auth != null",
      "{postId}": {
        // The owner of a post can update or delete it.
        "allow update, delete": "request.auth.uid == resource.data.userId",
        "likedByUsers": {
          // A user can only like/unlike for themselves.
          "{userId}": {
            "allow read, write": "request.auth.uid == userId"
          }
        },
        "comments": {
          // Anyone can read comments, but only logged-in users can create them.
          "allow read": true,
          "allow create": "request.auth != null"
        }
      }
    },
    "mandi_listings": {
      "allow read": true,
      "allow create": "request.auth != null",
      "{listingId}": {
         "allow update, delete": "request.auth.uid == resource.data.sellerId"
      }
    },
     "mandi_buyer_requests": {
      "allow read": true,
      "allow create": "request.auth != null",
      "{requestId}": {
         "allow delete": "request.auth.uid == resource.data.postedById"
      }
    },
    "conversations": {
       "{conversationId}": {
          // A user must be a participant to read/write to a conversation document.
          "allow read, write": "request.auth.uid in resource.data.participants",
          "messages": {
              // A user must be a participant in the parent conversation to read/create messages.
              "allow read, create": "get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])"
          }
       }
    },
    "notifications": {
      "{userId}": {
        "allow read, write, delete": "request.auth.uid == userId",
        // Allow access to the 'items' subcollection within a user's notification document
        "items": {
           "allow read, write, delete": "request.auth.uid == userId"
        }
      }
    },
     "notificationsMeta": {
      "{userId}": {
         // A user can only access their own notification metadata.
         "allow read, write": "request.auth.uid == userId"
      }
    },
    "yojna": {
      // Schemes are public to all users.
      "allow read": true
    }
  }
}
