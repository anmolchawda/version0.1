
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to user profiles, but only the user can write to their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth.uid == userId;
    }

    // Users can manage their own subcollections like bookmarks, followers, etc.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Allow public read on posts, but only the owner can modify.
    // Any authenticated user can create a post.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // Allow public read on comments, any authenticated user can create.
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Users can only like/unlike for themselves.
    match /posts/{postId}/likedByUsers/{userId} {
      allow read: if true;
      allow write, delete: if request.auth.uid == userId;
    }

    // Mandi listings are public to read.
    // Only authenticated users can create. Only owner can modify.
    match /mandi_listings/{listingId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth.uid == resource.data.sellerId;
    }
    
    // Buyer requests are public to read.
    // Only authenticated users can create. Only owner can delete.
    match /mandi_buyer_requests/{requestId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth.uid == resource.data.postedById;
    }

    // Notifications are private.
    match /notifications/{userId}/{collection}/{docId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Notification metadata is private.
    match /notificationsMeta/{userId} {
       allow read, write: if request.auth.uid == userId;
    }
    
    // Yojna data is public.
    match /yojna/{yojnaId} {
      allow read: if true;
    }
  }
}
