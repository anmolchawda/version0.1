rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global: only allow authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // ==========================
    // 👤 USERS
    // ==========================
    match /users/{userId} {
      // Allow reading only public fields like phone for Mandi post details
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      // Subcollections: bookmarks, followers, following
      match /bookmarks/{postId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /followers/{followerId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /following/{followingId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // ==========================
    // 📸 POSTS
    // ==========================
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth.uid == resource.data.userId;

      // Subcollection: comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null &&
                      request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth.uid == resource.data.userId;
      }

      // Subcollection: likes
      match /likedByUsers/{userId} {
        allow read: if true;
        allow create, delete: if request.auth.uid == userId;
      }
    }

    // ==========================
    // 🛒 MANDI POSTS
    // ==========================
    match /mandiPosts/{mandiPostId} {
      allow read: if true;
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // ==========================
    // 💬 MESSAGES (Direct Chat)
    // ==========================
    match /messages/{conversationId} {
      allow read, write: if request.auth != null &&
        request.resource.data.participants.hasAny([request.auth.uid]);

      // Messages inside the conversation
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // ==========================
    // 🔔 NOTIFICATIONS
    // ==========================
    match /notifications/{userId} {
      // Only receiver can read their notifications
      allow read: if request.auth.uid == userId;

      // Anyone can send notification to someone else
      match /items/{notificationId} {
        allow create: if request.auth != null &&
                      request.resource.data.fromUserId == request.auth.uid &&
                      request.resource.data.seen == false;
        allow read, update, delete: if request.auth.uid == userId;
      }
    }
  }
}
